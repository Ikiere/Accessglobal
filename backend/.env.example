# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Security & Master Encryption Key (32-byte hex for AES-256-GCM vault)
ENCRYPTION_MASTER_KEY=a7d3f89e1b2c4567890abcdef1234567890abcdef1234567890abcdef1234567
JWT_SECRET=super-secret-accessglobal-jwt-token-change-in-production
JWT_EXPIRES_IN=7d

# Supabase Configuration (Optional - can also be configured dynamically via Dashboard UI)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
