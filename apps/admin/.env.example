# AccessGlobal Admin Dashboard Environment Template
# Duplicate this file to .env.local for local development. Never commit .env with real credentials.

# API Gateway URL
VITE_API_URL=/api

# Optional: Supabase Public Anon Key (Never use service_role key in frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
