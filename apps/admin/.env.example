# AccessGlobal Admin Dashboard Environment Variables Template
# Copy this file to .env or .env.local for development.
# IMPORTANT: Never commit .env with production secrets to version control.

# 1. Supabase BaaS (Database & Authentication Engine)
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Resend Email Service (Operational Notifications)
VITE_RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_FROM_EMAIL=AccessGlobal <onboarding@resend.dev>
