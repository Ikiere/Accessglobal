# AccessGlobal Frontend Environment Template
# Duplicate this file to .env.local for local development. Never commit .env with real credentials.

# API Gateway URL (defaults to /api in local dev via Vite proxy)
VITE_API_URL=/api

# Optional: Supabase Public Keys for Direct Browser Connection
# Note: ONLY use the anon public key here. NEVER expose your service_role secret key in the frontend!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

